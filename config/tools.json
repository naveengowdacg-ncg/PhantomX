{
  "tools": [
    {
      "name": "nmap",
      "category": "recon",
      "executable": "nmap",
      "args": [
        "-sV",
        "{target}"
      ],
      "enabled": true,
      "timeout": 180,
      "retries": 0,
      "retry_on_timeout": false,
      "description": "Network discovery, port and service detection",
      "profile_args": {
        "passive": [
          "-sS",
          "-T1",
          "--max-retries",
          "0",
          "--host-timeout",
          "60s",
          "-p",
          "22,80,443",
          "{target}"
        ],
        "stealth": [
          "-sS",
          "-T2",
          "--max-retries",
          "1",
          "--host-timeout",
          "120s",
          "-p",
          "1-1024",
          "{target}"
        ],
        "standard": [
          "-sV",
          "-T3",
          "--max-retries",
          "2",
          "--host-timeout",
          "180s",
          "-p",
          "1-65535",
          "--version-light",
          "{target}"
        ],
        "full": [
          "-sV",
          "-sC",
          "-T3",
          "--max-retries",
          "2",
          "--host-timeout",
          "300s",
          "-p",
          "1-65535",
          "--version-intensity",
          "5",
          "{target}"
        ],
        "aggressive": [
          "-sV",
          "-sC",
          "-T4",
          "--max-retries",
          "1",
          "--host-timeout",
          "120s",
          "-p1-65535",
          "--version-intensity",
          "7",
          "--min-rate",
          "1000",
          "{target}"
        ]
      },
      "profile_timeout": {
        "passive": 120,
        "stealth": 180,
        "standard": 240,
        "full": 360,
        "aggressive": 300
      },
      "profile_retries": {
        "passive": 0,
        "stealth": 0,
        "standard": 1,
        "full": 1,
        "aggressive": 0
      },
      "profile_retry_on_timeout": {
        "passive": false,
        "stealth": false,
        "standard": false,
        "full": false,
        "aggressive": false
      }
    },
